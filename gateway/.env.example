SEGURIA_GATEWAY_ID=
SEGURIA_GATEWAY_SECRET=
SEGURIA_API_BASE_URL=https://seguria.tech

# Optional when the admin console has not delivered local bridge config yet.
SEGURIA_PROPERTY_ID=
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=

# Local MQTT broker included in docker-compose.yml.
MQTT_URL=mqtt://mqtt:1883
MQTT_USERNAME=seguria
MQTT_PASSWORD=change-me-before-install

HEARTBEAT_INTERVAL_SECONDS=60
SYNC_INTERVAL_SECONDS=30
EVENT_BUFFER_FILE=./data/events.json
OPERATION_QUEUE_FILE=./data/operations.json
