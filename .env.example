# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only Supabase key. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Server-only HMAC secret used to rate-limit contact submissions without storing IP addresses.
LEAD_IP_HASH_SECRET=replace-with-a-long-random-secret

# Gateway secrets are generated per installation and stored only as hashes.

# Server-only secret used by the scheduled gateway health monitor.
SEGURIA_MONITOR_SECRET=replace-with-a-long-random-secret

# Server-only key used to encrypt internal connection credentials before storing them.
# Use a 32-byte base64 value or a long random passphrase.
SEGURIA_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Runtime guardrails. Use production only for the production deployment and production data.
SEGURIA_ENVIRONMENT=development
SEGURIA_DATA_SCOPE=development

# Break-glass only. Keep false unless a controlled non-production operation is intentionally required.
SEGURIA_ALLOW_NON_PRODUCTION_OPERATIONS=false
