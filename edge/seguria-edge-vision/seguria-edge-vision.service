[Unit]
Description=SegurIA Edge Vision
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=seguria
Group=seguria
WorkingDirectory=/opt/seguria-edge-vision
Environment=SEGURIA_EDGE_CONFIG=/etc/seguria-edge-vision/config.yaml
ExecStart=/opt/seguria-edge-vision/.venv/bin/python /opt/seguria-edge-vision/main.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/seguria-edge-vision

[Install]
WantedBy=multi-user.target
